PORT=3000
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
REDIS_URL="redis://redis:6379"
GROQ_API_KEY=your-groq-api-key
OTM_KEY=your-opentripmap-key

# Bhashini — translation + speech-to-text for Indian languages.
# Get credentials from https://bhashini.gov.in (ULCA user id + API key).
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key
# Optional: override the default public MeitY pipeline id.
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Clerk — optional (stories / auth). Trip planning no longer goes through this backend.
CLERK_SECRET_KEY=your-clerk-secret-key

# --- Frontend (apps/frontend) ---
# Multi-agent trip planner API (Docker default host port 8080).
# Android emulator: http://10.0.2.2:8080
# Physical device: http://<your-lan-ip>:8080
EXPO_PUBLIC_TRIP_PLANNER_URL=http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:3000/api

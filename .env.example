PORT=3000
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
REDIS_URL="redis://redis:6379"
GROQ_API_KEY=your-groq-api-key
# Multi-agent trip planner model (8b has higher free-tier TPD than 70b).
GROQ_MODEL=llama-3.1-8b-instant
# Optional — India safety headlines via NewsAPI (safety agent degrades without it).
NEWS_API_KEY=
OTM_KEY=your-opentripmap-key

# Catalog ingest — Wikimedia wants a descriptive User-Agent (optional override).
# INGEST_USER_AGENT=AarohCatalogIngest/1.0 (you@example.com; catalog ingest)

# Bhashini — translation + speech-to-text for Indian languages.
# Get credentials from https://bhashini.gov.in (ULCA user id + API key).
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key
# Optional: override the default public MeitY pipeline id.
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Clerk — optional locally, required to save trip history per user.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# Frontend (Expo inlines EXPO_PUBLIC_* at bundler start).
# Also copy this into apps/frontend/.env if Expo does not load the repo-root .env.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# --- Frontend (apps/frontend) ---
# Trip planning goes through the Aaroh backend (/api/ai/trip/plan).
EXPO_PUBLIC_API_URL=http://localhost:3000/api
